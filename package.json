{
  "name": "@openfn/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/theme/tokens.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 --cache",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "compare": "node scripts/compare-lightning/compare.mjs",
    "kickstart:sync": "node kickstart/sync.mjs",
    "compare:all": "scripts/compare-lightning/run-all.sh",
    "test:stories": "vitest run --project storybook",
    "pixel-check": "node scripts/pixel-check.mjs",
    "pixel-check:clear": "node -e \"require('fs').rmSync('pixel-check-screenshots', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.28",
    "@headlessui/react": "^2.2.10",
    "clsx": "^2.1.1",
    "marked": "^16.4.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@monaco-editor/react": "^4.7.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "cronstrue": "2.50.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "heroicons": "^2.2.0",
    "js-yaml": "4.3.2",
    "jsdom": "^28.1.0",
    "monaco-editor": "^0.52.2",
    "playwright": "^1.56.0",
    "playwright-core": "1.56.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
